ENVIRONMENT=production
LOG_FORMAT=json
PORT=3000
# Use 0.0.0.0 inside containers; publish the API only through your proxy.
HOST=127.0.0.1
DB_URL=postgres://user:password@host:5432/database
BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=120000
AI_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT_REQUESTS=8
