{
  "name": "ai-app-starter",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "just dev",
    "test": "node --test --experimental-strip-types apps/api/src/_test_/*.test.ts packages/config/src/_test_/*.test.ts packages/inference/src/_test_/*.test.ts packages/trpc/src/_test_/*.test.ts",
    "test:integration": "node --test --experimental-strip-types apps/api/src/_integration_/*.test.ts packages/trpc/src/_integration_/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "biome check --config-path biome.json .",
    "format": "biome format --config-path biome.json --write .",
    "build": "npm run build:web",
    "build:web": "npm -w @app/web run build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:web",
    "db:generate": "npm -w @app/trpc run db:generate",
    "db:migrate": "npm -w @app/trpc run db:migrate"
  },
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "@trpc/server": "^11.10.0",
    "better-auth": "^1.6.18",
    "drizzle-orm": "^0.45.1",
    "openai": "^6.29.0",
    "pg": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@tanstack/react-query": "^5.59.16",
    "@trpc/client": "^11.9.0",
    "@trpc/react-query": "^11.9.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
