{
  "name": "ai-app-starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "just dev",
    "test": "node --test apps/api/src/_test_/*.test.ts packages/config/src/_test_/*.test.ts packages/inference/src/_test_/*.test.ts packages/trpc/src/_test_/*.test.ts \"apps/web/src/**/*.test.ts\"",
    "test:web": "node --test \"apps/web/src/**/*.test.ts\"",
    "eval:ai": "node scripts/eval-ai.ts",
    "eval:agent": "node scripts/eval-agent.ts",
    "test:integration": "node --test apps/api/src/_integration_/*.test.ts packages/trpc/src/_integration_/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "build": "npm run build:web",
    "build:web": "npm -w @app/web run build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:web",
    "db:generate": "npm -w @app/trpc run db:generate",
    "db:migrate": "npm -w @app/trpc run db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
